# Copyright 2026 Romain Dolbeau
# Source location: https://github.com/MelkhiorVintageComputing/RD68041
# The MC68LC040 guest (M13; doc/virt.md): rd-virt.config with the kernel's FPU
# emulation, which takes the F-line exceptions of every FP instruction when
# the bootinfo reports no FPU. What follows is rd-virt.config's own note.
#
# A minimal m68k virt kernel for the MC68040 only (M0 spike 5; doc/oracles.md,
# "Linux on QEMU's virt"), applied over allnoconfig: RD68031's rd-virt.config
# without the MC68030 and without the FPU emulation. With M68040 the kernel
# links in the M68040FPSP (arch/m68k/fpsp040, always built for the 040), which
# handles the unimplemented FP instructions and data types. An MC68LC040 needs
# M68KFPU_EMU=y as well (the kernel's own FP emulation, taken when the bootinfo
# reports no FPU); see doc/oracles.md.
CONFIG_LOCALVERSION="-rd040"
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_DEFAULT_HOSTNAME="rdvirt"
CONFIG_SYSVIPC=y
CONFIG_PRINTK=y
CONFIG_BUG=y
CONFIG_MULTIUSER=y
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_SHMEM=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_INITRAMFS_SOURCE=""
CONFIG_CC_OPTIMIZE_FOR_SIZE=y
CONFIG_NO_HZ_IDLE=y
CONFIG_HIGH_RES_TIMERS=y
# CPU / machine
CONFIG_MMU=y
CONFIG_M68KCLASSIC=y
# CONFIG_M68030 is not set
CONFIG_M68040=y
# CONFIG_M68020 is not set
# CONFIG_M68060 is not set
CONFIG_M68KFPU_EMU=y
CONFIG_VIRT=y
# CONFIG_AMIGA is not set
# CONFIG_ATARI is not set
# CONFIG_MAC is not set
# CONFIG_APOLLO is not set
# CONFIG_VME is not set
# CONFIG_HP300 is not set
# CONFIG_Q40 is not set
# CONFIG_SUN3X is not set
CONFIG_EARLY_PRINTK=y
CONFIG_PROC_HARDWARE=y
# devices
CONFIG_BLOCK=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TTY=y
CONFIG_GOLDFISH=y
CONFIG_GOLDFISH_TTY=y
CONFIG_GOLDFISH_TTY_EARLY_CONSOLE=y
CONFIG_RTC_CLASS=y
CONFIG_RTC_DRV_GOLDFISH=y
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_MMIO=y
CONFIG_BLK_DEV=y
CONFIG_VIRTIO_BLK=y
CONFIG_POWER_RESET=y
CONFIG_POWER_RESET_QEMU_VIRT_CTRL=y
# filesystems
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_EXT2_FS=y
# no networking
# CONFIG_NET is not set
# CONFIG_MODULES is not set
CONFIG_PRINTK_TIME=y
