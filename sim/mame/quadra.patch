+// RD68041 (M14): the Quadra 650 and the Centris 650 with the core in place of
+// MAME's m68040 and 68LC040 (sim/mame/rd68041.h; $RD68041_VLT names the
+// core's build, the MC68040's or the MC68LC040's).
+void quadra800_state::macqd650rd(machine_config &config)
+{
+	macqd650(config);
+
+	RD68041(config.replace(), m_maincpu, 33_MHz_XTAL);
+	m_maincpu->set_addrmap(AS_PROGRAM, &quadra800_state::quadra800_map);
+	m_maincpu->set_dasm_override(std::function(&mac68k_dasm_override), "mac68k_dasm_override");
+}
+
+void quadra800_state::macct650rd(machine_config &config)
+{
+	macct650(config);
+
+	RD68041(config.replace(), m_maincpu, 25_MHz_XTAL);
+	m_maincpu->set_addrmap(AS_PROGRAM, &quadra800_state::quadra800_map);
+	m_maincpu->set_dasm_override(std::function(&mac68k_dasm_override), "mac68k_dasm_override");
+}
+
